
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap');

@import "tailwindcss";

:root {
  --purple: #401078;
  --purple-dark: #250647;
  --gold: #d6ad55;
  --white: #ffffff;
  --light: #f8f6fb;
  --text: #292333;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  scroll-behavior: smooth;
}

body {
  font-family: 'Inter', sans-serif;
  color: var(--text);
  background: white;
}

a {
  text-decoration: none;
  color: inherit;
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 7%;
  background: white;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 3px 15px #0000000d;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--purple);
  font-weight: 800;
  font-size: 14px;
}

.brand-mark {
  background: var(--purple);
  color: var(--gold);
  padding: 10px;
  border-radius: 10px;
  font-size: 22px;
}

.navbar nav {
  display: flex;
  gap: 25px;
  font-size: 14px;
  font-weight: 600;
}

.navbar nav a:hover {
  color: var(--gold);
}

.nav-button,
.card-button {
  background: var(--purple);
  color: white;
  padding: 12px 22px;
  border-radius: 8px;
  font-weight: 700;
}

.hero {
  min-height: 590px;
  display: flex;
  align-items: center;
  padding: 80px 8%;
  color: white;
  background:
    linear-gradient(90deg, #250647f5, #401078d9),
    url('https://images.unsplash.com/photo-1519167758481-83f550bb49b3?w=1800')
    center/cover;
}

.hero-content {
  max-width: 720px;
}

.eyebrow {
  color: var(--gold);
  font-weight: 800;
  letter-spacing: 2px;
  font-size: 12px;
}

.hero h1 {
  font-family: 'Poppins', sans-serif;
  font-size: clamp(36px, 6vw, 65px);
  line-height: 1.15;
  margin: 22px 0;
}

.hero h1 span {
  color: var(--gold);
}

.hero-content > p {
  line-height: 1.8;
  max-width: 570px;
  color: #eee6f5;
}

.hero-actions {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.gold-button {
  display: inline-block;
  background: var(--gold);
  color: var(--purple-dark);
  padding: 15px 24px;
  border-radius: 8px;
  font-weight: 800;
}

.outline-button {
  display: inline-block;
  border: 1px solid white;
  color: white;
  padding: 15px 24px;
  border-radius: 8px;
  font-weight: 700;
}

.hero-note {
  margin-top: 40px;
  font-size: 13px;
  color: #e9dff2;
}

.section {
  padding: 85px 7%;
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 45px;
}

.section-heading h2,
.contact-section h2 {
  font-family: 'Poppins', sans-serif;
  font-size: clamp(27px, 4vw, 40px);
  color: var(--purple);
  margin: 12px 0;
}

.section-heading p {
  color: #77717f;
  line-height: 1.7;
}

.pack-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.pack-card {
  background: white;
  border: 1px solid #eee8f4;
  border-radius: 16px;
  padding: 25px 20px;
  position: relative;
  box-shadow: 0 8px 25px #35105d0c;
}

.pack-card.popular {
  border: 2px solid var(--gold);
}

.popular-label {
  display: inline-block;
  background: var(--gold);
  color: var(--purple-dark);
  padding: 6px 10px;
  font-size: 10px;
  font-weight: 800;
  border-radius: 5px;
  margin-bottom: 12px;
}

.pack-card h3 {
  color: var(--purple);
  font-size: 18px;
}

.price {
  color: var(--purple);
  font-size: 28px;
  font-weight: 800;
  margin-top: 20px;
}

.price small {
  font-size: 12px;
}

.per-day {
  color: #888;
  font-size: 12px;
  margin-top: 4px;
}

.pack-card ul {
  list-style: none;
  margin: 25px 0;
}

.pack-card li {
  padding: 10px 0;
  border-bottom: 1px solid #f0edf3;
  font-size: 13px;
}

.pack-card li::before {
  content: "✓";
  color: #22985d;
  font-weight: 800;
  margin-right: 9px;
}

.card-button {
  display: block;
  text-align: center;
  font-size: 13px;
}

.alternate {
  background: var(--light);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.service-card {
  background: white;
  border-radius: 14px;
  padding: 28px;
  border: 1px solid #eee8f4;
  box-shadow: 0 5px 20px #00000006;
}

.service-card > span {
  font-size: 35px;
}

.service-card h3 {
  color: var(--purple);
  margin: 15px 0;
  font-family: 'Poppins', sans-serif;
}

.service-card p {
  color: #716b78;
  font-size: 14px;
  line-height: 1.8;
}

.service-card strong {
  display: inline-block;
  margin-top: 12px;
  color: #b1842c;
}

.contact-section {
  text-align: center;
  padding: 80px 7%;
  background: var(--purple-dark);
  color: white;
}

.contact-section h2 {
  color: white;
}

.contact-section p {
  color: #e5dced;
  line-height: 1.8;
  margin: 15px auto 25px;
  max-width: 600px;
}

.contact-section .location {
  margin-top: 25px;
}

footer {
  background: #19052e;
  color: white;
  text-align: center;
  padding: 35px 15px;
}

footer strong {
  color: var(--gold);
  font-size: 21px;
}

footer p {
  margin-top: 13px;
  font-size: 13px;
  color: #d9cde5;
}

.social-links {
  display: flex;
  justify-content: center;
  gap: 25px;
  flex-wrap: wrap;
  margin: 22px 0;
}

.social-links a {
  color: var(--gold);
  font-weight: 700;
}

@media (max-width: 1000px) {
  .pack-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .service-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .navbar {
    padding: 12px 5%;
    flex-wrap: wrap;
    gap: 12px;
  }

  .navbar nav {
    order: 3;
    width: 100%;
    overflow-x: auto;
    gap: 18px;
    padding: 8px 0;
    font-size: 12px;
  }

  .nav-button {
    padding: 10px 14px;
    font-size: 12px;
  }

  .hero {
    min-height: 530px;
    padding: 65px 6%;
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-actions a {
    text-align: center;
  }

  .section {
    padding: 60px 5%;
  }

  .pack-grid,
  .service-grid {
    grid-template-columns: 1fr;
  }

  .pack-card {
    padding: 25px;
  }


